# Copy this file to .env and replace every placeholder before running Docker Compose.
POSTGRES_USER=logistics
POSTGRES_PASSWORD=replace-with-a-strong-database-password
SECRET_KEY=replace-with-a-long-random-application-secret
N8N_BASIC_AUTH_USER=operations-admin
N8N_BASIC_AUTH_PASSWORD=replace-with-a-strong-n8n-password
N8N_ENCRYPTION_KEY=replace-with-a-long-random-n8n-encryption-key
WORKFLOW_API_TOKEN=replace-with-a-long-random-workflow-token

# AI provider selection. Use 'gemini' for the free tier, 'openai' for paid, 'auto' to try gemini then openai.
# Leave keys blank only for local demo fallback (heuristic, $0, offline).
AI_PROVIDER=gemini
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# OpenRouter (OpenAI-compatible, :free models cost $0). Example free model id:
# OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=

# Keep false only for local development. Production must set this to true and
# point to a reachable ClamAV daemon; uploads fail closed if scanning is unavailable.
DOCUMENT_SCAN_REQUIRED=false
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
