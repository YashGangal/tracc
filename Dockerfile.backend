FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ /app/

EXPOSE 8000

# PORT is set by hosts like Render (default 10000); local Docker Compose
# leaves it unset and falls back to 8000.
CMD ["sh", "-c", "python app/db/seed_data.py && python -c \"from app.ml.predictor import _load_artifacts; _load_artifacts()\" && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
